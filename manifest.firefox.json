{
  "manifest_version": 3,
  "name": "Image Format Saver: Save as JPG, PNG or WebP",
  "short_name": "Image Format Saver",
  "version": "1.0.0",
  "description": "Right-click any picture to save it as JPG, PNG or WebP, or copy it as PNG. Converted on your computer. Free, private, no tracking.",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "convert.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Image Format Saver options",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://techygeekshome.info/browser-extensions/image-format-saver/",
  "browser_specific_settings": {
    "gecko": {
      "id": "imageformatsaver@techygeekshome.info",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}